# HARP local development
NODE_ENV=development
PORT=3000

# Optional server-side AI integration.
# Never expose this value in client-side VITE_* variables.
GEMINI_API_KEY=

# Optional production origin used for security headers/CORS.
APP_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Hedera Consensus Service (HCS) — real integration (server-side only)
# Never commit real keys. Never expose these as VITE_* client variables.
# ---------------------------------------------------------------------------
# Network: testnet | mainnet
HEDERA_NETWORK=testnet

# Operator account (pays fees). Create a free testnet account at:
# https://portal.hedera.com/
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=

# Optional: reuse an existing topic. Leave empty to create one on first use.
HEDERA_TOPIC_ID=
