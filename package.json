{
  "name": "hedera-shield-protocol",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "HARP — IoT security and verifiable security-event architecture built around Hedera.",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "node server.ts",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/securityEvents.test.ts tests/protocol.test.ts tests/copilot.test.ts",
    "test:hcs": "tsx --test tests/hcs.integration.test.ts",
    "test:watch": "tsx --watch --test tests/securityEvents.test.ts tests/protocol.test.ts tests/copilot.test.ts",
    "check": "npm run test && npm run lint && npm run build"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@hashgraph/sdk": "^2.69.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
